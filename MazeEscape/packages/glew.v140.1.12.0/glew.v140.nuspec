  <metadata>
    <id>glew.v140</id>
    <version>1.12.0</version>
    <title>The OpenGL Extension Wrangler Library</title>
    <authors>Milan Ikits,  Marcelo Magallon,  Lev Povalahev</authors>
    <owners>Milan Ikits, Marcelo Magallon, Lev Povalahev</owners>
